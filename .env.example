# 复制为 .env 并填入真实值（.env 不要提交）

# Gemini 免费 API key：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily 网页搜索 key（可选，用于补 RSS 之外的新闻）：https://app.tavily.com
TAVILY_API_KEY=

# QQ 邮箱 SMTP
# SMTP_USER 是你的 QQ 邮箱地址；SMTP_PASS 是「授权码」(不是登录密码)
# 获取：QQ 邮箱 → 设置 → 账号 → 开启 IMAP/SMTP 服务 → 生成授权码
SMTP_USER=youremail@qq.com
SMTP_PASS=your_qq_authorization_code
MAIL_TO=your_inbox@qq.com
